# Local compose Postgres. Neon comes later (D33) — same URL shape.
DATABASE_URL=postgresql+psycopg://crewlane:crewlane@localhost:5432/crewlane
FRONTEND_ORIGIN=http://localhost:3000

# Session wall (D42, D53). Name + email → JWT in HttpOnly cookie. Not Stytch.
DEV_AUTH=true
DEV_SESSION_SECRET=dev-only-not-for-production-32-bytes

# Groq (D28). Leave GROQ_API_KEY empty for scripted stand-in (no external calls).
# Add fallbacks as GROQ_API_KEY_FALLBACKS=key2,key3 (or comma-separate GROQ_API_KEY).
GROQ_API_KEY=
GROQ_API_KEY_FALLBACKS=
GROQ_MODEL=openai/gpt-oss-120b

# Object storage (D34). Docker compose uses MinIO; leave empty for local-disk fallback.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
LOCAL_UPLOAD_DIR=./data/uploads

# Web search for optional feasibility research (D24, D31).
SERPAPI_KEY=

# Ingestion worker (D32). Compose sets true; keep false for host-only API without worker.
JOB_WORKER_ENABLED=false

# Local embeddings, EmbeddingGemma-300M (D70) - no key needed, but the model
# is gated on Hugging Face: accept the license at
# https://huggingface.co/google/embeddinggemma-300m, then set a read token.
HF_TOKEN=

# Personal OneDrive sync (D85). Leave MICROSOFT_CLIENT_ID empty to disable OAuth.
# ONEDRIVE_LOCAL_MIRROR_DIR writes the same folder layout to disk (tests/demo).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_TENANT=consumers
ONEDRIVE_LOCAL_MIRROR_DIR=
